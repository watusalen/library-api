# Configurações de Ambiente da Aplicação (Library API)

# Perfil ativo do Spring (dev | prod)
SPRING_PROFILES_ACTIVE=prod

# Porta do Servidor (Padrão: 8080)
PORT=8080

# Banco de Dados PostgreSQL
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/library
SPRING_DATASOURCE_USERNAME=library_user
SPRING_DATASOURCE_PASSWORD=library_pass

# Configurações opcionais de pool de conexões em produção
HIKARI_MAX_POOL_SIZE=10
HIKARI_MIN_IDLE=5

# Comportamento de DDL em Produção (validate | none)
SPRING_JPA_HIBERNATE_DDL_AUTO=validate

# Autenticação JWT (OBRIGATÓRIO: Chave secreta de no mínimo 32 caracteres / 256 bits)
JWT_SECRET=matusalencalves_secret_key_jwt_token_library_2026_prod
JWT_EXPIRATION_SECONDS=3600
